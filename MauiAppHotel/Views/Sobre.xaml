<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10"
                         Spacing="10">

        <Label Text="Sobre"
               FontFamily="Kalam"
               FontSize="50"
               TextColor="{StaticResource Primary}" />

        <Frame Padding="15">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout>
                    <Label Text="Aplicativo: " />
                    <Label Text="App Hotel" TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Desenvolvedor: " />
                    <Label Text="Oswaldo" TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Ano: " />
                    <Label Text="2026" TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Tecnologia: " />
                    <Label Text=".NET MAUI" TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>
