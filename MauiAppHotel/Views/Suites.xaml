<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Suites"
             Title="Nossas Suítes"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout Padding="10" Spacing="10">

        <Label Text="Nossas Suítes"
               FontFamily="Kalam"
               FontSize="44"
               TextColor="{StaticResource Primary}" />

        <CollectionView x:Name="cv_suites">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,10" Padding="15">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Descricao}"
                                   FontSize="Large"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding ValorDiariaAdulto, StringFormat='Adulto: {0:C2} por diária'}" />
                            <Label Text="{Binding ValorDiariaCrianca, StringFormat='Criança: {0:C2} por diária'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>
